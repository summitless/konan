# Git LFS 跟踪所有平台的二进制. 文件本身不进 git history, 走 LFS 存储,
# 让 lgpl 分支的 clone / push 不被几百 MB 的 .so / .o 拖垮.

# 共通的二进制扩展
*.dll       filter=lfs diff=lfs merge=lfs -text
*.dylib     filter=lfs diff=lfs merge=lfs -text
*.a         filter=lfs diff=lfs merge=lfs -text
*.o         filter=lfs diff=lfs merge=lfs -text

# .so 系列 (含带版本号的: libQt6Core.so.6 等)
*.so        filter=lfs diff=lfs merge=lfs -text
*.so.*      filter=lfs diff=lfs merge=lfs -text

# Mach-O executable (macOS .app/Contents/MacOS/<App>, iOS resources/binary 等)
# 这些没扩展名, 用具体路径模式. iOS resources 里没 binary (我们排除掉了),
# macOS .app 的可执行在 Contents/MacOS/.
macos/*/*.app/Contents/MacOS/*    filter=lfs diff=lfs merge=lfs -text

# Windows .exe
*.exe       filter=lfs diff=lfs merge=lfs -text
